* text=auto eol=lf
*.bat text eol=crlf

# Retained compiler outputs must preserve bytes recorded by SHA256 manifests.
results/recorded/aarch64/*.s -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/recorded/aarch64/*.ll -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
